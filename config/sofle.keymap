#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

// GAME must sit below LOWER/RAISE so those layers still override it.
#define BASE 0
#define GAME 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define GAME_MOD 5
#define GAME_RAISE 6 // GAME + RAISE: knob arms auto-repeat
#define AUTO 7 // sticky: next key toggles auto-repeat

/ {

    behaviors {
        // &ar KEY: toggle auto-repeat of KEY with a random 200-1000 ms pause between taps
        ar: auto_repeat {
            compatible = "zmk,behavior-auto-repeat";
            #binding-cells = <1>;
            min-delay-ms = <200>;
            max-delay-ms = <1000>;
            hold-ms = <600000>; // 10 min
            game-layer = <GAME>;
        };

        // Sticky AUTO layer, 3 s to press the key to (un)repeat
        sl_auto: sticky_layer_auto {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <3000>;
            quick-release;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_backspace {
            timeout-ms = <50>;
            key-positions = <13 14>;
            layers = <BASE LOWER RAISE ADJUST>;
            bindings = <&kp BSPC>;
        };
        combo_return {
            timeout-ms = <50>;
            key-positions = <25 26>;
            layers = <BASE LOWER RAISE ADJUST>;
            bindings = <&kp RET>;
        };
        // Toggle GAME: press left + right encoder knobs together
        combo_game_toggle {
            timeout-ms = <100>;
            key-positions = <42 43>;
            layers = <BASE GAME>;
            bindings = <&tog GAME>;
        };
    };

   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
        // Holding RAISE in GAME: right knob arms auto-repeat
        game_raise_layer {
            if-layers = <GAME RAISE>;
            then-layer = <GAME_RAISE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   BKSPC   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | ` |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | ALT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | S_G_A |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//               | CTRL| ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| GUI   | ALT   | CTRL  |
            bindings = <
&kp ESC &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp GRAVE
&kp LSHFT   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LALT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &kp LG(LS(A)) &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LCTRL &kp LALT &kp LGUI &mo LOWER  &kp SPACE    &kp RET  &lt RAISE BSPC  &kp RGUI &kp RALT  &kp LCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp LEFT RIGHT>;
        };

        game_layer {
            display-name = "game";
// Plain QWERTY without combos; LOWER key is replaced by GAME_MOD
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   BKSPC   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | ` |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | ALT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | S_G_A |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//               | CTRL| ALT  | GUI  | GMOD |  SPACE |  | ENTER | RAISE| GUI   | ALT   | CTRL  |
            bindings = <
&kp ESC &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp GRAVE
&kp LSHFT   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LALT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &kp LG(LS(A)) &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LCTRL &kp LALT &kp LGUI &mo GAME_MOD  &kp SPACE    &kp RET  &lt RAISE BSPC  &kp RGUI &kp RALT  &kp LCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp LEFT RIGHT>;
        };

        lower_layer {
            display-name = "lower";
// TODO: Some binds are waiting for shifted keycode support.
// ------------------------------------------------------------------------------------------------------------
// |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
// |       | OPT1| OPT2| OPT3 | OPT4 | C_UP |                   |  ^   |  UP   |  *    |  (   |   )   |   |   |
// |       |  =  |  -  |  +   |  {   | C_DN |        |  |       | LEFT | DOWN  | RIGHT |  :   |   \   |       |
//               |     |      |      |  PP  |        |  |       |      |       |       |      |
            bindings = <
&trans    &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                    &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
&kp GRAVE &kp N1    &kp N2    &kp N3      &kp N4    &kp N5                    &kp N6    &kp N7   &kp N8    &kp N9    &kp N0    &kp F12
&trans    &kp LA(N1) &kp LA(N2) &kp LA(N3) &kp LA(N4) &kp LC(UP)                 &kp CARET &kp UP   &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
&trans    &kp EQUAL &kp MINUS &kp PLUS &kp LBRC  &kp LC(DOWN)   &trans &trans  &kp LEFT  &kp DOWN &kp RIGHT &kp COLON &kp BSLH  &trans
                    &trans    &trans      &trans    &trans     &kp C_PP &trans  &trans    &trans   &trans    &trans
            >;

           sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP &inc_dec_kp DOWN UP>;
        };


        raise_layer {
            display-name = "raise";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
// |       | INS  | PSCR | GUI   |       |      |                |  ^   |  &   |   *   |  (   |   )   |       |
// |       | ALT  | CTRL | SHIFT |       | CAPS |                |  -   |  =   |   [   |  ]   |   \   | BKSPC |
// |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |  _   |  +   |   {   |  }   |   |   |       |
//                |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans    &trans   &trans    &trans  &trans
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &trans
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &kp BSPC
&trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans        &trans  &trans  &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &trans
                        &trans       &trans       &trans       &trans        &trans  &trans  &trans    &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp LEFT RIGHT>;
        };

        adjust_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
            display-name = "adjust";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &none &none
&none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &none &none &none
&none             &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &none  &none &none &none &none &none &none
                                  &none           &none           &none           &none            &none           &none  &none &none &none &none
            >;
        };

        game_mod_layer {
            display-name = "gamemod";
// Left half numpad, right half transparent
// ------------------------------------------------------------------------------------------------------------
// |       |     | NUM  |  /   |  *   |  -   |                   |      |       |       |      |       |       |
// |       |     |  7   |  8   |  9   |  +   |                   |      |       |       |      |       |       |
// |       |  .  |  4   |  5   |  6   |  +   |                   |      |       |       |      |       |       |
// |       |  0  |  1   |  2   |  3   | ENTR |        |  |       |      |       |       |      |       |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
&trans &trans    &kp KP_NUM &kp KP_SLASH &kp KP_MULTIPLY &kp KP_MINUS                 &trans &trans &trans &trans &trans &trans
&trans &trans    &kp KP_N7  &kp KP_N8    &kp KP_N9       &kp KP_PLUS                  &trans &trans &trans &trans &trans &trans
&trans &kp KP_DOT &kp KP_N4 &kp KP_N5    &kp KP_N6       &kp KP_PLUS                  &trans &trans &trans &trans &trans &trans
&trans &kp KP_N0 &kp KP_N1  &kp KP_N2    &kp KP_N3       &kp KP_ENTER  &trans  &trans &trans &trans &trans &trans &trans &trans
                 &trans     &trans       &trans          &trans        &trans  &trans &trans &trans &trans &trans
            >;
        };

        game_raise_layer {
            display-name = "gameraise";
// Only the right knob does something: tap it, then tap a key to start/stop repeating it
            bindings = <
&trans &trans &trans &trans &trans &trans                 &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                 &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                 &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &sl_auto AUTO &trans &trans &trans &trans &trans &trans
       &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        auto_layer {
            display-name = "auto";
// Mirrors GAME; every plain key toggles its own auto-repeat, modifiers/layer keys do nothing
            bindings = <
&ar ESC  &ar N1 &ar N2 &ar N3 &ar N4 &ar N5                  &ar N6 &ar N7 &ar N8    &ar N9  &ar N0   &ar BSPC
&ar TAB  &ar Q  &ar W  &ar E  &ar R  &ar T                   &ar Y  &ar U  &ar I     &ar O   &ar P    &ar GRAVE
&none    &ar A  &ar S  &ar D  &ar F  &ar G                   &ar H  &ar J  &ar K     &ar L   &ar SEMI &ar SQT
&none    &ar Z  &ar X  &ar C  &ar V  &ar B  &none  &none     &ar N  &ar M  &ar COMMA &ar DOT &ar FSLH &none
         &none  &none  &none  &none  &ar SPACE               &ar RET &none &none     &none   &none
            >;
        };

    };
};
